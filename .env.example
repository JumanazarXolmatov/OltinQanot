# Oltin Qanot Bot Configuration
# Copy this file to .env and fill in your actual values

# Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Admin Configuration (comma-separated list of Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Channel Configuration (comma-separated list of channel usernames with @)
REQUIRED_CHANNELS=@your_channel_1,@your_channel_2

# Database Configuration
DATABASE_NAME=oltin_qanot.db
BACKUP_DIR=backups

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Contest Configuration
CONTEST_NAME=Oltin Qanot Referral Contest
CONTEST_START_DATE=2026-01-28
CONTEST_END_DATE=2026-02-28

# Feature Flags
ENABLE_MULTI_LANGUAGE=true
ENABLE_AUTO_BACKUP=true
ENABLE_RATE_LIMITING=true

# Rate Limiting (requests per minute per user)
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_COMMANDS=10
